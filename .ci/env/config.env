# =============================================================================
# Project configuration — version-controlled, NO secrets here
# Secrets go in .ci/env/.env (gitignored)
# =============================================================================

# Project
SOURCE_KIND=quarkus
PACKAGE_TYPE=native

# Compiler driver — determines which lib is loaded by lifecycle scripts
# Supported: maven | (future: gradle, sbt, npm...)
COMPILER=maven

# JDK selection — directory that contains one subdirectory per installed JDK.
# The driver reads the required Java version from pom.xml and resolves JAVA_HOME
# automatically. Leave empty to use JAVA_HOME from the environment or system Java.
#
# Expected layouts inside JDK_DIR:
#   Symlink convention:  $JDK_DIR/17 → /path/to/jdk17/home
#   macOS .jdk bundles:  $JDK_DIR/jdk-17.x.y.jdk/Contents/Home
#   Linux / Temurin:     $JDK_DIR/jdk-17.x.y+z/  or  $JDK_DIR/java-17-openjdk/
#
# On macOS, /usr/libexec/java_home is tried as a fallback when JDK_DIR is unset
# or the requested version is not found there.
JDK_DIR=

# Branches
MAIN_BRANCH=main
DEVELOP_BRANCH=develop

# Git flow / changelog
CHANGELOG_INCLUDE_BODY=true

# Docker registry
IMAGE_REGISTRY=registry.gitlab.com
IMAGE_NAME=phylax2/phylax-api
DOCKERFILE=src/main/docker/Dockerfile.native-micro.multistage

# Quality
SAST=owasp
