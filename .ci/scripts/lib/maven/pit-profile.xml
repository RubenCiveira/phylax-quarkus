<!--
  CI profile: mutation testing (PIT)
  Runs mutation testing via PIT + JUnit5 plugin.
  Activated by: mvn test -Pci-mutation

  Mutation threshold passed as Maven property:
    -DmutationThreshold=80

  Reports written to: target/pit-reports/

  Slow — intended for nightly pipelines or on-demand runs.
  Owned by CI team — do not add to pom.xml profiles.
-->
<profile>
  <id>ci-mutation</id>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.11</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${surefire.argLine}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.14.3</version>
        <executions>
          <execution>
            <id>ci-pit-report</id>
            <phase>test</phase>
            <goals>
              <goal>mutationCoverage</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
        <configuration>
          <timestampedReports>false</timestampedReports>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <jacoco.skip>true</jacoco.skip>
    <surefire.argLine></surefire.argLine>
  </properties>
</profile>
