<!--
  CI profile: lint
  Runs PMD static analysis + CPD duplicate code detection.
  Activated by: mvn verify -Pci-lint
  Reports written to: target/lint/

  Owned by CI team — do not add to pom.xml profiles.
-->
<profile>
  <id>ci-lint</id>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.21.2</version>
        <executions>
          <execution>
            <id>ci-pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>pmd</goal>
              <goal>cpd</goal>
              <goal>check</goal>
              <goal>cpd-check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <printFailingErrors>true</printFailingErrors>
          <format>csv</format>
          <failOnViolation>true</failOnViolation>
          <linkXRef>false</linkXRef>
        </configuration>
      </plugin>
    </plugins>
  </build>
</profile>
