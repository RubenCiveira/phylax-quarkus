' @autogenerated
@startuml
title Modificación de tenant terms of use
autonumber
actor "Cliente" as A
participant "TenantTermsOfUseUpdateController" as C
participant "TenantTermsOfUseUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantTermsOfUsesVisibility" as V
participant "TenantTermsOfUse" as D
participant "TenantTermsOfUseCommandRepositoryGateway" as G
participant "TenantTermsOfUseEventDispatcher" as E
participant "TenantTermsOfUseCacheGateway" as K
participant "TenantTermsOfUseAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : TenantTermsOfUseUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TenantTermsOfUseUpdateCheck
U -> P : TenantTermsOfUseUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : TenantTermsOfUseUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : TenantTermsOfUseUpdateProjection
C --> A : respuesta
@enduml
