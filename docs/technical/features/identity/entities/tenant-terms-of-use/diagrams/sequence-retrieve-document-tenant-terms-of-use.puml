' @autogenerated
@startuml
title Descarga de document de tenant terms of use
autonumber
actor "Cliente" as A
participant "TenantTermsOfUseDocumentUploadController" as C
participant "TenantTermsOfUseDocumentRetrieveUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantTermsOfUsesVisibility" as V
participant "TenantTermsOfUseDocumentUploadGateway" as S

A -> C : petición HTTP
C -> U : read(context, ...)
U -> P : TenantTermsOfUseDocumentRetrieveAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisible(context, uid)
V --> U : registro, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> S : readDocument(entity)
S --> U : BinaryContent
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U --> C : BinaryContent
C --> A : respuesta
@enduml
