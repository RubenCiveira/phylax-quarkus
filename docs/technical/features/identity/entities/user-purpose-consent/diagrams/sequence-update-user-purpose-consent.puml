' @autogenerated
@startuml
title Modificación de user purpose consent
autonumber
actor "Cliente" as A
participant "UserPurposeConsentUpdateController" as C
participant "UserPurposeConsentUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserPurposeConsentsVisibility" as V
participant "UserPurposeConsent" as D
participant "UserPurposeConsentCommandRepositoryGateway" as G
participant "UserPurposeConsentEventDispatcher" as E
participant "UserPurposeConsentCacheGateway" as K
participant "UserPurposeConsentAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserPurposeConsentUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserPurposeConsentUpdateCheck
U -> P : UserPurposeConsentUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserPurposeConsentUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserPurposeConsentUpdateProjection
C --> A : respuesta
@enduml
