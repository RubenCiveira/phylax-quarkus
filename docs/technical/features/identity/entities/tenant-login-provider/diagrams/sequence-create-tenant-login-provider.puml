end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TenantLoginProviderCreateCheck
U -> P : TenantLoginProviderCreateEnrich
U -> D : TenantLoginProvider.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : TenantLoginProviderCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : TenantLoginProviderCreateProjection
C --> A : respuesta
