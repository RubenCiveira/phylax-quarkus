' @autogenerated
@startuml
title Descarga de saml idp cert de tenant login provider
autonumber
actor "Cliente" as A
participant "TenantLoginProviderSamlIdpCertUploadController" as C
participant "TenantLoginProviderSamlIdpCertRetrieveUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantLoginProvidersVisibility" as V
participant "TenantLoginProviderSamlIdpCertUploadGateway" as S

A -> C : petición HTTP
C -> U : read(context, ...)
U -> P : TenantLoginProviderSamlIdpCertRetrieveAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisible(context, uid)
V --> U : registro, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> S : readSamlIdpCert(entity)
S --> U : BinaryContent
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U --> C : BinaryContent
C --> A : respuesta
@enduml
