' @autogenerated
@startuml
title Modificación de tenant login provider
autonumber
actor "Cliente" as A
participant "TenantLoginProviderUpdateController" as C
participant "TenantLoginProviderUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantLoginProvidersVisibility" as V
participant "TenantLoginProvider" as D
participant "TenantLoginProviderCommandRepositoryGateway" as G
participant "TenantLoginProviderEventDispatcher" as E
participant "TenantLoginProviderCacheGateway" as K
participant "TenantLoginProviderAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : TenantLoginProviderUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TenantLoginProviderUpdateCheck
U -> P : TenantLoginProviderUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : TenantLoginProviderUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : TenantLoginProviderUpdateProjection
C --> A : respuesta
@enduml
