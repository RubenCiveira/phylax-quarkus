' @autogenerated
@startuml
title Listado de consent purpose
autonumber
actor "Cliente" as A
participant "ConsentPurposeListController" as C
participant "ConsentPurposeListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ConsentPurposesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ConsentPurposeListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ConsentPurposeListProjection>
C --> A : respuesta
@enduml
