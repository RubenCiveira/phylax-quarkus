' @autogenerated
@startuml
title Modificación de consent purpose
autonumber
actor "Cliente" as A
participant "ConsentPurposeUpdateController" as C
participant "ConsentPurposeUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ConsentPurposesVisibility" as V
participant "ConsentPurpose" as D
participant "ConsentPurposeCommandRepositoryGateway" as G
participant "ConsentPurposeEventDispatcher" as E
participant "ConsentPurposeCacheGateway" as K
participant "ConsentPurposeAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ConsentPurposeUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ConsentPurposeUpdateCheck
U -> P : ConsentPurposeUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ConsentPurposeUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ConsentPurposeUpdateProjection
C --> A : respuesta
@enduml
