' @autogenerated
@startuml
title Creación de user federated identity
autonumber
actor "Cliente" as A
participant "UserFederatedIdentityCreateController" as C
participant "UserFederatedIdentityCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserFederatedIdentitiesVisibility" as V
participant "UserFederatedIdentity" as D
participant "UserFederatedIdentityCommandRepositoryGateway" as G
participant "UserFederatedIdentityEventDispatcher" as E
participant "UserFederatedIdentityCacheGateway" as K
participant "UserFederatedIdentityAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : UserFederatedIdentityCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserFederatedIdentityCreateCheck
U -> P : UserFederatedIdentityCreateEnrich
U -> D : UserFederatedIdentity.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : UserFederatedIdentityCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : UserFederatedIdentityCreateProjection
C --> A : respuesta
@enduml
