' @autogenerated
@startuml
title Modificación de user federated identity
autonumber
actor "Cliente" as A
participant "UserFederatedIdentityUpdateController" as C
participant "UserFederatedIdentityUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserFederatedIdentitiesVisibility" as V
participant "UserFederatedIdentity" as D
participant "UserFederatedIdentityCommandRepositoryGateway" as G
participant "UserFederatedIdentityEventDispatcher" as E
participant "UserFederatedIdentityCacheGateway" as K
participant "UserFederatedIdentityAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserFederatedIdentityUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserFederatedIdentityUpdateCheck
U -> P : UserFederatedIdentityUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserFederatedIdentityUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserFederatedIdentityUpdateProjection
C --> A : respuesta
@enduml
