' @autogenerated
@startuml
title Listado de user federated identity
autonumber
actor "Cliente" as A
participant "UserFederatedIdentityListController" as C
participant "UserFederatedIdentityListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserFederatedIdentitiesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : UserFederatedIdentityListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<UserFederatedIdentityListProjection>
C --> A : respuesta
@enduml
