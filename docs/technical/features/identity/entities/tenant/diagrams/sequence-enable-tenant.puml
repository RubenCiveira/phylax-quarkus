' @autogenerated
@startuml
title Enable de tenant
autonumber
actor "Cliente" as A
participant "TenantEnableController" as C
participant "TenantEnableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantsVisibility" as V
participant "Tenant" as D
participant "TenantCommandRepositoryGateway" as G
participant "TenantEventDispatcher" as E
participant "TenantCacheGateway" as K
participant "TenantAuditGateway" as R

A -> C : petición HTTP
C -> U : enable(context, ...)
U -> P : TenantEnableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : TenantEnableCheck
U -> D : original.enable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : TenantEnableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("enable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : TenantEnableProjection
C --> A : respuesta
@enduml
