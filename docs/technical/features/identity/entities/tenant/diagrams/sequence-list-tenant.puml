' @autogenerated
@startuml
title Listado de tenant
autonumber
actor "Cliente" as A
participant "TenantListController" as C
participant "TenantListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : TenantListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<TenantListProjection>
C --> A : respuesta
@enduml
