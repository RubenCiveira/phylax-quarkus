' @autogenerated
@startuml
title Borrado de tenant
autonumber
actor "Cliente" as A
participant "TenantDeleteController" as C
participant "TenantDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantsVisibility" as V
participant "Tenant" as D
participant "TenantCommandRepositoryGateway" as G
participant "TenantEventDispatcher" as E
participant "TenantCacheGateway" as K
participant "TenantAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : TenantDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : TenantDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : TenantDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
