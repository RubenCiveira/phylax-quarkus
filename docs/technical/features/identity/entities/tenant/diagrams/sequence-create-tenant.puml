' @autogenerated
@startuml
title Creación de tenant
autonumber
actor "Cliente" as A
participant "TenantCreateController" as C
participant "TenantCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantsVisibility" as V
participant "Tenant" as D
participant "TenantCommandRepositoryGateway" as G
participant "TenantEventDispatcher" as E
participant "TenantCacheGateway" as K
participant "TenantAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : TenantCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TenantCreateCheck
U -> P : TenantCreateEnrich
U -> D : Tenant.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : TenantCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : TenantCreateProjection
C --> A : respuesta
@enduml
