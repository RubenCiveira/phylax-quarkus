' @autogenerated
@startuml
title Modificación de user profile
autonumber
actor "Cliente" as A
participant "UserProfileUpdateController" as C
participant "UserProfileUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserProfilesVisibility" as V
participant "UserProfile" as D
participant "UserProfileCommandRepositoryGateway" as G
participant "UserProfileEventDispatcher" as E
participant "UserProfileCacheGateway" as K
participant "UserProfileAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserProfileUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserProfileUpdateCheck
U -> P : UserProfileUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserProfileUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserProfileUpdateProjection
C --> A : respuesta
@enduml
