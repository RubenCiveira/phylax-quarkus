' @autogenerated
@startuml
title Listado de user profile
autonumber
actor "Cliente" as A
participant "UserProfileListController" as C
participant "UserProfileListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserProfilesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : UserProfileListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<UserProfileListProjection>
C --> A : respuesta
@enduml
