' @autogenerated
@startuml
title Creación de user profile
autonumber
actor "Cliente" as A
participant "UserProfileCreateController" as C
participant "UserProfileCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserProfilesVisibility" as V
participant "UserProfile" as D
