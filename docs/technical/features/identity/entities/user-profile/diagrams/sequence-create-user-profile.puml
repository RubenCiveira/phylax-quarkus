end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserProfileCreateCheck
U -> P : UserProfileCreateEnrich
U -> D : UserProfile.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : UserProfileCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : UserProfileCreateProjection
C --> A : respuesta
