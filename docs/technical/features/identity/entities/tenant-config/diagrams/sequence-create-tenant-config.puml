' @autogenerated
@startuml
title Creación de tenant config
autonumber
actor "Cliente" as A
participant "TenantConfigCreateController" as C
participant "TenantConfigCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantConfigsVisibility" as V
participant "TenantConfig" as D
participant "TenantConfigCommandRepositoryGateway" as G
participant "TenantConfigEventDispatcher" as E
participant "TenantConfigCacheGateway" as K
participant "TenantConfigAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : TenantConfigCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TenantConfigCreateCheck
U -> P : TenantConfigCreateEnrich
U -> D : TenantConfig.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : TenantConfigCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : TenantConfigCreateProjection
C --> A : respuesta
@enduml
