' @autogenerated
@startuml
title Borrado de tenant config
autonumber
actor "Cliente" as A
participant "TenantConfigDeleteController" as C
participant "TenantConfigDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantConfigsVisibility" as V
participant "TenantConfig" as D
participant "TenantConfigCommandRepositoryGateway" as G
participant "TenantConfigEventDispatcher" as E
participant "TenantConfigCacheGateway" as K
participant "TenantConfigAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : TenantConfigDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : TenantConfigDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : TenantConfigDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
