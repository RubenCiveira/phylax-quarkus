' @autogenerated
@startuml
title Modificación de tenant config
autonumber
actor "Cliente" as A
participant "TenantConfigUpdateController" as C
participant "TenantConfigUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantConfigsVisibility" as V
participant "TenantConfig" as D
participant "TenantConfigCommandRepositoryGateway" as G
participant "TenantConfigEventDispatcher" as E
participant "TenantConfigCacheGateway" as K
participant "TenantConfigAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : TenantConfigUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TenantConfigUpdateCheck
U -> P : TenantConfigUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : TenantConfigUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : TenantConfigUpdateProjection
C --> A : respuesta
@enduml
