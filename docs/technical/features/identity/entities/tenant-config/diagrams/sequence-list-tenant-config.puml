' @autogenerated
@startuml
title Listado de tenant config
autonumber
actor "Cliente" as A
participant "TenantConfigListController" as C
participant "TenantConfigListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TenantConfigsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : TenantConfigListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<TenantConfigListProjection>
C --> A : respuesta
@enduml
