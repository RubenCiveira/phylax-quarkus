' @autogenerated
@startuml
title Block de user
autonumber
actor "Cliente" as A
participant "UserBlockController" as C
participant "UserBlockUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UsersVisibility" as V
participant "User" as D
participant "UserCommandRepositoryGateway" as G
participant "UserEventDispatcher" as E
participant "UserCacheGateway" as K
participant "UserAuditGateway" as R

A -> C : petición HTTP
C -> U : block(context, ...)
U -> P : UserBlockAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : UserBlockCheck
U -> D : original.block()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserBlockEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("block", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserBlockProjection
C --> A : respuesta
@enduml
