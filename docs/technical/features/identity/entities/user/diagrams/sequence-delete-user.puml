' @autogenerated
@startuml
title Borrado de user
autonumber
actor "Cliente" as A
participant "UserDeleteController" as C
participant "UserDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UsersVisibility" as V
participant "User" as D
participant "UserCommandRepositoryGateway" as G
participant "UserEventDispatcher" as E
participant "UserCacheGateway" as K
participant "UserAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : UserDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : UserDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : UserDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
