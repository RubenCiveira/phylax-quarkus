' @autogenerated
@startuml
title Change password de user
autonumber
actor "Cliente" as A
participant "UserChangePasswordController" as C
participant "UserChangePasswordUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UsersVisibility" as V
participant "User" as D
participant "UserCommandRepositoryGateway" as G
participant "UserEventDispatcher" as E
participant "UserCacheGateway" as K
participant "UserAuditGateway" as R

A -> C : petición HTTP
C -> U : changePassword(context, ...)
U -> P : UserChangePasswordAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : UserChangePasswordCheck
U -> D : original.changePassword()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserChangePasswordEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("changePassword", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserChangePasswordProjection
C --> A : respuesta
@enduml
