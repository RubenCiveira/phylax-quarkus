' @autogenerated
@startuml
title Consulta de user
autonumber
actor "Cliente" as A
participant "UserRetrieveController" as C
participant "UserRetrieveUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UsersVisibility" as V

A -> C : petición HTTP
C -> U : retrieve(context, ...)
U -> P : UserRetrieveAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveCachedVisible(context, uid)
V --> U : registro, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : UserRetrieveProjection
C --> A : respuesta
@enduml
