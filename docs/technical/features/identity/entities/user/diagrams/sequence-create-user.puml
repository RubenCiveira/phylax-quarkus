' @autogenerated
@startuml
title Creación de user
autonumber
actor "Cliente" as A
participant "UserCreateController" as C
participant "UserCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UsersVisibility" as V
participant "User" as D
participant "UserCommandRepositoryGateway" as G
participant "UserEventDispatcher" as E
participant "UserCacheGateway" as K
participant "UserAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : UserCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserCreateCheck
U -> P : UserCreateEnrich
U -> D : User.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : UserCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : UserCreateProjection
C --> A : respuesta
@enduml
