' @autogenerated
@startuml
title Listado de user accepted terms of use
autonumber
actor "Cliente" as A
participant "UserAcceptedTermsOfUseListController" as C
participant "UserAcceptedTermsOfUseListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserAcceptedTermsOfUsesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : UserAcceptedTermsOfUseListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<UserAcceptedTermsOfUseListProjection>
C --> A : respuesta
@enduml
