' @autogenerated
@startuml
title Creación de user accepted terms of use
autonumber
actor "Cliente" as A
participant "UserAcceptedTermsOfUseCreateController" as C
participant "UserAcceptedTermsOfUseCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserAcceptedTermsOfUsesVisibility" as V
participant "UserAcceptedTermsOfUse" as D
participant "UserAcceptedTermsOfUseCommandRepositoryGateway" as G
participant "UserAcceptedTermsOfUseEventDispatcher" as E
participant "UserAcceptedTermsOfUseCacheGateway" as K
participant "UserAcceptedTermsOfUseAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : UserAcceptedTermsOfUseCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserAcceptedTermsOfUseCreateCheck
U -> P : UserAcceptedTermsOfUseCreateEnrich
U -> D : UserAcceptedTermsOfUse.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : UserAcceptedTermsOfUseCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : UserAcceptedTermsOfUseCreateProjection
C --> A : respuesta
@enduml
