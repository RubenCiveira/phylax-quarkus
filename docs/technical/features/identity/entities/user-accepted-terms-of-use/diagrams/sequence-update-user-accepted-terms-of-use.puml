' @autogenerated
@startuml
title Modificación de user accepted terms of use
autonumber
actor "Cliente" as A
participant "UserAcceptedTermsOfUseUpdateController" as C
participant "UserAcceptedTermsOfUseUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserAcceptedTermsOfUsesVisibility" as V
participant "UserAcceptedTermsOfUse" as D
participant "UserAcceptedTermsOfUseCommandRepositoryGateway" as G
participant "UserAcceptedTermsOfUseEventDispatcher" as E
participant "UserAcceptedTermsOfUseCacheGateway" as K
participant "UserAcceptedTermsOfUseAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserAcceptedTermsOfUseUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserAcceptedTermsOfUseUpdateCheck
U -> P : UserAcceptedTermsOfUseUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserAcceptedTermsOfUseUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserAcceptedTermsOfUseUpdateProjection
C --> A : respuesta
@enduml
