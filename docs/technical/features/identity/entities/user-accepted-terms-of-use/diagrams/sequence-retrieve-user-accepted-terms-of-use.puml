' @autogenerated
@startuml
title Consulta de user accepted terms of use
autonumber
actor "Cliente" as A
participant "UserAcceptedTermsOfUseRetrieveController" as C
participant "UserAcceptedTermsOfUseRetrieveUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserAcceptedTermsOfUsesVisibility" as V

A -> C : petición HTTP
C -> U : retrieve(context, ...)
U -> P : UserAcceptedTermsOfUseRetrieveAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveCachedVisible(context, uid)
V --> U : registro, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : UserAcceptedTermsOfUseRetrieveProjection
C --> A : respuesta
@enduml
