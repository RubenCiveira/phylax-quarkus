' @autogenerated
@startuml
title Record activity de observed source
autonumber
actor "Cliente" as A
participant "ObservedSourceRecordActivityController" as C
participant "ObservedSourceRecordActivityUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSourcesVisibility" as V
participant "ObservedSource" as D
participant "ObservedSourceCommandRepositoryGateway" as G
participant "ObservedSourceEventDispatcher" as E
participant "ObservedSourceCacheGateway" as K
participant "ObservedSourceAuditGateway" as R

A -> C : petición HTTP
C -> U : recordActivity(context, ...)
U -> P : ObservedSourceRecordActivityAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedSourceRecordActivityCheck
U -> D : original.recordActivity()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedSourceRecordActivityEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("recordActivity", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedSourceRecordActivityProjection
C --> A : respuesta
@enduml
