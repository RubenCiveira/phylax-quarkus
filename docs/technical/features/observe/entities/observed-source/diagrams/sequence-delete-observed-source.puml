' @autogenerated
@startuml
title Borrado de observed source
autonumber
actor "Cliente" as A
participant "ObservedSourceDeleteController" as C
participant "ObservedSourceDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSourcesVisibility" as V
participant "ObservedSource" as D
participant "ObservedSourceCommandRepositoryGateway" as G
participant "ObservedSourceEventDispatcher" as E
participant "ObservedSourceCacheGateway" as K
participant "ObservedSourceAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ObservedSourceDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedSourceDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ObservedSourceDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
