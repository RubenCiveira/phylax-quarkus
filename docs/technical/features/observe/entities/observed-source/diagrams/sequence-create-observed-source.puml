' @autogenerated
@startuml
title Creación de observed source
autonumber
actor "Cliente" as A
participant "ObservedSourceCreateController" as C
participant "ObservedSourceCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSourcesVisibility" as V
participant "ObservedSource" as D
participant "ObservedSourceCommandRepositoryGateway" as G
participant "ObservedSourceEventDispatcher" as E
participant "ObservedSourceCacheGateway" as K
participant "ObservedSourceAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservedSourceCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedSourceCreateCheck
U -> P : ObservedSourceCreateEnrich
U -> D : ObservedSource.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservedSourceCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservedSourceCreateProjection
C --> A : respuesta
@enduml
