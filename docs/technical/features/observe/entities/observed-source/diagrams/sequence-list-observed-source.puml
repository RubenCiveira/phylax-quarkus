' @autogenerated
@startuml
title Listado de observed source
autonumber
actor "Cliente" as A
participant "ObservedSourceListController" as C
participant "ObservedSourceListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSourcesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ObservedSourceListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ObservedSourceListProjection>
C --> A : respuesta
@enduml
