' @autogenerated
@startuml
title Modificación de observed source
autonumber
actor "Cliente" as A
participant "ObservedSourceUpdateController" as C
participant "ObservedSourceUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSourcesVisibility" as V
participant "ObservedSource" as D
participant "ObservedSourceCommandRepositoryGateway" as G
participant "ObservedSourceEventDispatcher" as E
participant "ObservedSourceCacheGateway" as K
participant "ObservedSourceAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedSourceUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedSourceUpdateCheck
U -> P : ObservedSourceUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedSourceUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedSourceUpdateProjection
C --> A : respuesta
@enduml
