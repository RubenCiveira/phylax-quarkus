' @autogenerated
@startuml
title Disable de observed slo
autonumber
actor "Cliente" as A
participant "ObservedSloDisableController" as C
participant "ObservedSloDisableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSlosVisibility" as V
participant "ObservedSlo" as D
participant "ObservedSloCommandRepositoryGateway" as G
participant "ObservedSloEventDispatcher" as E
participant "ObservedSloCacheGateway" as K
participant "ObservedSloAuditGateway" as R

A -> C : petición HTTP
C -> U : disable(context, ...)
U -> P : ObservedSloDisableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedSloDisableCheck
U -> D : original.disable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedSloDisableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("disable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedSloDisableProjection
C --> A : respuesta
@enduml
