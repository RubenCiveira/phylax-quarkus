' @autogenerated
@startuml
title Modificación de observed slo
autonumber
actor "Cliente" as A
participant "ObservedSloUpdateController" as C
participant "ObservedSloUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSlosVisibility" as V
participant "ObservedSlo" as D
participant "ObservedSloCommandRepositoryGateway" as G
participant "ObservedSloEventDispatcher" as E
participant "ObservedSloCacheGateway" as K
participant "ObservedSloAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedSloUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedSloUpdateCheck
U -> P : ObservedSloUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedSloUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedSloUpdateProjection
C --> A : respuesta
@enduml
