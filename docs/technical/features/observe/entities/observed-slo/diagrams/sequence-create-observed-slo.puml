' @autogenerated
@startuml
title Creación de observed slo
autonumber
actor "Cliente" as A
participant "ObservedSloCreateController" as C
participant "ObservedSloCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSlosVisibility" as V
participant "ObservedSlo" as D
participant "ObservedSloCommandRepositoryGateway" as G
participant "ObservedSloEventDispatcher" as E
participant "ObservedSloCacheGateway" as K
participant "ObservedSloAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservedSloCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedSloCreateCheck
U -> P : ObservedSloCreateEnrich
U -> D : ObservedSlo.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservedSloCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservedSloCreateProjection
C --> A : respuesta
@enduml
