' @autogenerated
@startuml
title Borrado de observed slo
autonumber
actor "Cliente" as A
participant "ObservedSloDeleteController" as C
participant "ObservedSloDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedSlosVisibility" as V
participant "ObservedSlo" as D
participant "ObservedSloCommandRepositoryGateway" as G
participant "ObservedSloEventDispatcher" as E
participant "ObservedSloCacheGateway" as K
participant "ObservedSloAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ObservedSloDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedSloDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ObservedSloDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
