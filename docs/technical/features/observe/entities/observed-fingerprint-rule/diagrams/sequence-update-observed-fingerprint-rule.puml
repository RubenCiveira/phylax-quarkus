' @autogenerated
@startuml
title Modificación de observed fingerprint rule
autonumber
actor "Cliente" as A
participant "ObservedFingerprintRuleUpdateController" as C
participant "ObservedFingerprintRuleUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedFingerprintRulesVisibility" as V
participant "ObservedFingerprintRule" as D
participant "ObservedFingerprintRuleCommandRepositoryGateway" as G
participant "ObservedFingerprintRuleEventDispatcher" as E
participant "ObservedFingerprintRuleCacheGateway" as K
participant "ObservedFingerprintRuleAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedFingerprintRuleUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedFingerprintRuleUpdateCheck
U -> P : ObservedFingerprintRuleUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedFingerprintRuleUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedFingerprintRuleUpdateProjection
C --> A : respuesta
@enduml
