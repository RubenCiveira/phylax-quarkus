' @autogenerated
@startuml
title Modificación de observed issue
autonumber
actor "Cliente" as A
participant "ObservedIssueUpdateController" as C
participant "ObservedIssueUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedIssuesVisibility" as V
participant "ObservedIssue" as D
participant "ObservedIssueCommandRepositoryGateway" as G
participant "ObservedIssueEventDispatcher" as E
participant "ObservedIssueCacheGateway" as K
participant "ObservedIssueAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedIssueUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedIssueUpdateCheck
U -> P : ObservedIssueUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedIssueUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedIssueUpdateProjection
C --> A : respuesta
@enduml
