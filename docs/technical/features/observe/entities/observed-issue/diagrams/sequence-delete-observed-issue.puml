' @autogenerated
@startuml
title Borrado de observed issue
autonumber
actor "Cliente" as A
participant "ObservedIssueDeleteController" as C
participant "ObservedIssueDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedIssuesVisibility" as V
participant "ObservedIssue" as D
participant "ObservedIssueCommandRepositoryGateway" as G
participant "ObservedIssueEventDispatcher" as E
participant "ObservedIssueCacheGateway" as K
participant "ObservedIssueAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ObservedIssueDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedIssueDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ObservedIssueDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
