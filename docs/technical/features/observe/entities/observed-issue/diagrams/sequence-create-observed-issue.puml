' @autogenerated
@startuml
title Creación de observed issue
autonumber
actor "Cliente" as A
participant "ObservedIssueCreateController" as C
participant "ObservedIssueCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedIssuesVisibility" as V
participant "ObservedIssue" as D
participant "ObservedIssueCommandRepositoryGateway" as G
participant "ObservedIssueEventDispatcher" as E
participant "ObservedIssueCacheGateway" as K
participant "ObservedIssueAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservedIssueCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedIssueCreateCheck
U -> P : ObservedIssueCreateEnrich
U -> D : ObservedIssue.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservedIssueCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservedIssueCreateProjection
C --> A : respuesta
@enduml
