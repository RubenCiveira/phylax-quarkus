' @autogenerated
@startuml
title Listado de observed issue
autonumber
actor "Cliente" as A
participant "ObservedIssueListController" as C
participant "ObservedIssueListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedIssuesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ObservedIssueListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ObservedIssueListProjection>
C --> A : respuesta
@enduml
