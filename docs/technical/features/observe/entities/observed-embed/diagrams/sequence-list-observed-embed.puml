' @autogenerated
@startuml
title Listado de observed embed
autonumber
actor "Cliente" as A
participant "ObservedEmbedListController" as C
participant "ObservedEmbedListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedEmbedsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ObservedEmbedListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ObservedEmbedListProjection>
C --> A : respuesta
@enduml
