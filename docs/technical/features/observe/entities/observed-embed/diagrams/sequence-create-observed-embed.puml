' @autogenerated
@startuml
title Creación de observed embed
autonumber
actor "Cliente" as A
participant "ObservedEmbedCreateController" as C
participant "ObservedEmbedCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedEmbedsVisibility" as V
participant "ObservedEmbed" as D
participant "ObservedEmbedCommandRepositoryGateway" as G
participant "ObservedEmbedEventDispatcher" as E
participant "ObservedEmbedCacheGateway" as K
participant "ObservedEmbedAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservedEmbedCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedEmbedCreateCheck
U -> P : ObservedEmbedCreateEnrich
U -> D : ObservedEmbed.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservedEmbedCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservedEmbedCreateProjection
C --> A : respuesta
@enduml
