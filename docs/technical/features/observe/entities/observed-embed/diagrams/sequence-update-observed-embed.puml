' @autogenerated
@startuml
title Modificación de observed embed
autonumber
actor "Cliente" as A
participant "ObservedEmbedUpdateController" as C
participant "ObservedEmbedUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedEmbedsVisibility" as V
participant "ObservedEmbed" as D
participant "ObservedEmbedCommandRepositoryGateway" as G
participant "ObservedEmbedEventDispatcher" as E
participant "ObservedEmbedCacheGateway" as K
participant "ObservedEmbedAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedEmbedUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedEmbedUpdateCheck
U -> P : ObservedEmbedUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedEmbedUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedEmbedUpdateProjection
C --> A : respuesta
@enduml
