' @autogenerated
@startuml
title Borrado de observed embed
autonumber
actor "Cliente" as A
participant "ObservedEmbedDeleteController" as C
participant "ObservedEmbedDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedEmbedsVisibility" as V
participant "ObservedEmbed" as D
participant "ObservedEmbedCommandRepositoryGateway" as G
participant "ObservedEmbedEventDispatcher" as E
participant "ObservedEmbedCacheGateway" as K
participant "ObservedEmbedAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ObservedEmbedDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedEmbedDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ObservedEmbedDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
