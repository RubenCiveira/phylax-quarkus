' @autogenerated
@startuml
title Borrado de observed dashboard
autonumber
actor "Cliente" as A
participant "ObservedDashboardDeleteController" as C
participant "ObservedDashboardDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedDashboardsVisibility" as V
participant "ObservedDashboard" as D
participant "ObservedDashboardCommandRepositoryGateway" as G
participant "ObservedDashboardEventDispatcher" as E
participant "ObservedDashboardCacheGateway" as K
participant "ObservedDashboardAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ObservedDashboardDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedDashboardDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ObservedDashboardDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
