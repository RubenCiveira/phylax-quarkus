' @autogenerated
@startuml
title Creación de observed dashboard
autonumber
actor "Cliente" as A
participant "ObservedDashboardCreateController" as C
participant "ObservedDashboardCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedDashboardsVisibility" as V
participant "ObservedDashboard" as D
participant "ObservedDashboardCommandRepositoryGateway" as G
participant "ObservedDashboardEventDispatcher" as E
participant "ObservedDashboardCacheGateway" as K
participant "ObservedDashboardAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservedDashboardCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedDashboardCreateCheck
U -> P : ObservedDashboardCreateEnrich
U -> D : ObservedDashboard.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservedDashboardCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservedDashboardCreateProjection
C --> A : respuesta
@enduml
