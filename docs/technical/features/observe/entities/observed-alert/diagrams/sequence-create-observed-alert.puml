' @autogenerated
@startuml
title Creación de observed alert
autonumber
actor "Cliente" as A
participant "ObservedAlertCreateController" as C
participant "ObservedAlertCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedAlertsVisibility" as V
participant "ObservedAlert" as D
participant "ObservedAlertCommandRepositoryGateway" as G
participant "ObservedAlertEventDispatcher" as E
participant "ObservedAlertCacheGateway" as K
participant "ObservedAlertAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservedAlertCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedAlertCreateCheck
U -> P : ObservedAlertCreateEnrich
U -> D : ObservedAlert.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservedAlertCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservedAlertCreateProjection
C --> A : respuesta
@enduml
