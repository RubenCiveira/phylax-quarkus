' @autogenerated
@startuml
title Listado de observed alert
autonumber
actor "Cliente" as A
participant "ObservedAlertListController" as C
participant "ObservedAlertListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedAlertsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ObservedAlertListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ObservedAlertListProjection>
C --> A : respuesta
@enduml
