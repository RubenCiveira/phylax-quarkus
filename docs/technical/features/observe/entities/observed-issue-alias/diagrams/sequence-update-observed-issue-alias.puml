' @autogenerated
@startuml
title Modificación de observed issue alias
autonumber
actor "Cliente" as A
participant "ObservedIssueAliasUpdateController" as C
participant "ObservedIssueAliasUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedIssueAliassVisibility" as V
participant "ObservedIssueAlias" as D
participant "ObservedIssueAliasCommandRepositoryGateway" as G
participant "ObservedIssueAliasEventDispatcher" as E
participant "ObservedIssueAliasCacheGateway" as K
participant "ObservedIssueAliasAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedIssueAliasUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedIssueAliasUpdateCheck
U -> P : ObservedIssueAliasUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedIssueAliasUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedIssueAliasUpdateProjection
C --> A : respuesta
@enduml
