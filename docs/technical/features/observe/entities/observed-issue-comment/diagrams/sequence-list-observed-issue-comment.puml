' @autogenerated
@startuml
title Listado de observed issue comment
autonumber
actor "Cliente" as A
participant "ObservedIssueCommentListController" as C
participant "ObservedIssueCommentListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedIssueCommentsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ObservedIssueCommentListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ObservedIssueCommentListProjection>
C --> A : respuesta
@enduml
