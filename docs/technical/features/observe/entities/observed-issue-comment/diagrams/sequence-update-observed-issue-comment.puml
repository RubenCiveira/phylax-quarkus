' @autogenerated
@startuml
title Modificación de observed issue comment
autonumber
actor "Cliente" as A
participant "ObservedIssueCommentUpdateController" as C
participant "ObservedIssueCommentUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedIssueCommentsVisibility" as V
participant "ObservedIssueComment" as D
participant "ObservedIssueCommentCommandRepositoryGateway" as G
participant "ObservedIssueCommentEventDispatcher" as E
participant "ObservedIssueCommentCacheGateway" as K
participant "ObservedIssueCommentAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedIssueCommentUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedIssueCommentUpdateCheck
U -> P : ObservedIssueCommentUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedIssueCommentUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedIssueCommentUpdateProjection
C --> A : respuesta
@enduml
