' @autogenerated
@startuml
title Creación de observability config
autonumber
actor "Cliente" as A
participant "ObservabilityConfigCreateController" as C
participant "ObservabilityConfigCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservabilityConfigsVisibility" as V
participant "ObservabilityConfig" as D
participant "ObservabilityConfigCommandRepositoryGateway" as G
participant "ObservabilityConfigEventDispatcher" as E
participant "ObservabilityConfigCacheGateway" as K
participant "ObservabilityConfigAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservabilityConfigCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservabilityConfigCreateCheck
U -> P : ObservabilityConfigCreateEnrich
U -> D : ObservabilityConfig.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservabilityConfigCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservabilityConfigCreateProjection
C --> A : respuesta
@enduml
