' @autogenerated
@startuml
title Borrado de observability config
autonumber
actor "Cliente" as A
participant "ObservabilityConfigDeleteController" as C
participant "ObservabilityConfigDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservabilityConfigsVisibility" as V
participant "ObservabilityConfig" as D
participant "ObservabilityConfigCommandRepositoryGateway" as G
participant "ObservabilityConfigEventDispatcher" as E
participant "ObservabilityConfigCacheGateway" as K
participant "ObservabilityConfigAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ObservabilityConfigDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservabilityConfigDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ObservabilityConfigDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
