' @autogenerated
@startuml
title Listado de observability config
autonumber
actor "Cliente" as A
participant "ObservabilityConfigListController" as C
participant "ObservabilityConfigListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservabilityConfigsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ObservabilityConfigListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ObservabilityConfigListProjection>
C --> A : respuesta
@enduml
