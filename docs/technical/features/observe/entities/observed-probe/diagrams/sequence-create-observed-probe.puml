' @autogenerated
@startuml
title Creación de observed probe
autonumber
actor "Cliente" as A
participant "ObservedProbeCreateController" as C
participant "ObservedProbeCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedProbesVisibility" as V
participant "ObservedProbe" as D
participant "ObservedProbeCommandRepositoryGateway" as G
participant "ObservedProbeEventDispatcher" as E
participant "ObservedProbeCacheGateway" as K
participant "ObservedProbeAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ObservedProbeCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedProbeCreateCheck
U -> P : ObservedProbeCreateEnrich
U -> D : ObservedProbe.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ObservedProbeCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ObservedProbeCreateProjection
C --> A : respuesta
@enduml
