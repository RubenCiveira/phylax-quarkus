' @autogenerated
@startuml
title Modificación de observed probe
autonumber
actor "Cliente" as A
participant "ObservedProbeUpdateController" as C
participant "ObservedProbeUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedProbesVisibility" as V
participant "ObservedProbe" as D
participant "ObservedProbeCommandRepositoryGateway" as G
participant "ObservedProbeEventDispatcher" as E
participant "ObservedProbeCacheGateway" as K
participant "ObservedProbeAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ObservedProbeUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ObservedProbeUpdateCheck
U -> P : ObservedProbeUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedProbeUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedProbeUpdateProjection
C --> A : respuesta
@enduml
