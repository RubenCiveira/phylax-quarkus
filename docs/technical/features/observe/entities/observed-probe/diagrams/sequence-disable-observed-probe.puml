@startuml
title Disable de observed probe
autonumber
actor "Cliente" as A
participant "ObservedProbeDisableController" as C
participant "ObservedProbeDisableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedProbesVisibility" as V
participant "ObservedProbe" as D
participant "ObservedProbeCommandRepositoryGateway" as G
participant "ObservedProbeEventDispatcher" as E
participant "ObservedProbeCacheGateway" as K
participant "ObservedProbeAuditGateway" as R

A -> C : petición HTTP
C -> U : disable(context, ...)
U -> P : ObservedProbeDisableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedProbeDisableCheck
U -> D : original.disable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ObservedProbeDisableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("disable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ObservedProbeDisableProjection
C --> A : respuesta
@enduml
