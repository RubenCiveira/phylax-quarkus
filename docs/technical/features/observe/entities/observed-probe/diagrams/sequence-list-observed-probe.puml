' @autogenerated
@startuml
title Listado de observed probe
autonumber
actor "Cliente" as A
participant "ObservedProbeListController" as C
participant "ObservedProbeListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedProbesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ObservedProbeListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ObservedProbeListProjection>
C --> A : respuesta
@enduml
