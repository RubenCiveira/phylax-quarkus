' @autogenerated
@startuml
title Borrado de observed probe
autonumber
actor "Cliente" as A
participant "ObservedProbeDeleteController" as C
participant "ObservedProbeDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ObservedProbesVisibility" as V
participant "ObservedProbe" as D
participant "ObservedProbeCommandRepositoryGateway" as G
participant "ObservedProbeEventDispatcher" as E
participant "ObservedProbeCacheGateway" as K
participant "ObservedProbeAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ObservedProbeDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ObservedProbeDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ObservedProbeDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
