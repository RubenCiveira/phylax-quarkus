' @autogenerated
@startuml
title Modificación de user mfa enrollment
autonumber
actor "Cliente" as A
participant "UserMfaEnrollmentUpdateController" as C
participant "UserMfaEnrollmentUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserMfaEnrollmentsVisibility" as V
participant "UserMfaEnrollment" as D
participant "UserMfaEnrollmentCommandRepositoryGateway" as G
participant "UserMfaEnrollmentEventDispatcher" as E
participant "UserMfaEnrollmentCacheGateway" as K
participant "UserMfaEnrollmentAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserMfaEnrollmentUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserMfaEnrollmentUpdateCheck
U -> P : UserMfaEnrollmentUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserMfaEnrollmentUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserMfaEnrollmentUpdateProjection
C --> A : respuesta
@enduml
