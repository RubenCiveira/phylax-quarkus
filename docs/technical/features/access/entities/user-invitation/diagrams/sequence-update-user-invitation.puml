' @autogenerated
@startuml
title Modificación de user invitation
autonumber
actor "Cliente" as A
participant "UserInvitationUpdateController" as C
participant "UserInvitationUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserInvitationsVisibility" as V
participant "UserInvitation" as D
participant "UserInvitationCommandRepositoryGateway" as G
participant "UserInvitationEventDispatcher" as E
participant "UserInvitationCacheGateway" as K
participant "UserInvitationAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserInvitationUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserInvitationUpdateCheck
U -> P : UserInvitationUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserInvitationUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserInvitationUpdateProjection
C --> A : respuesta
@enduml
