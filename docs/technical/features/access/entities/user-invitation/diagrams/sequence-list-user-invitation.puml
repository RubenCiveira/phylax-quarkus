' @autogenerated
@startuml
title Listado de user invitation
autonumber
actor "Cliente" as A
participant "UserInvitationListController" as C
participant "UserInvitationListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserInvitationsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : UserInvitationListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<UserInvitationListProjection>
C --> A : respuesta
@enduml
