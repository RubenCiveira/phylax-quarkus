' @autogenerated
@startuml
title Borrado de user login throttle
autonumber
actor "Cliente" as A
participant "UserLoginThrottleDeleteController" as C
participant "UserLoginThrottleDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserLoginThrottlesVisibility" as V
participant "UserLoginThrottle" as D
participant "UserLoginThrottleCommandRepositoryGateway" as G
participant "UserLoginThrottleEventDispatcher" as E
participant "UserLoginThrottleCacheGateway" as K
participant "UserLoginThrottleAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : UserLoginThrottleDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : UserLoginThrottleDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : UserLoginThrottleDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
