' @autogenerated
@startuml
title Creación de user login throttle
autonumber
actor "Cliente" as A
participant "UserLoginThrottleCreateController" as C
participant "UserLoginThrottleCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserLoginThrottlesVisibility" as V
participant "UserLoginThrottle" as D
participant "UserLoginThrottleCommandRepositoryGateway" as G
participant "UserLoginThrottleEventDispatcher" as E
participant "UserLoginThrottleCacheGateway" as K
participant "UserLoginThrottleAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : UserLoginThrottleCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserLoginThrottleCreateCheck
U -> P : UserLoginThrottleCreateEnrich
U -> D : UserLoginThrottle.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : UserLoginThrottleCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : UserLoginThrottleCreateProjection
C --> A : respuesta
@enduml
