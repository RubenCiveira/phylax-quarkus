' @autogenerated
@startuml
title Listado de user login throttle
autonumber
actor "Cliente" as A
participant "UserLoginThrottleListController" as C
participant "UserLoginThrottleListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserLoginThrottlesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : UserLoginThrottleListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<UserLoginThrottleListProjection>
C --> A : respuesta
@enduml
