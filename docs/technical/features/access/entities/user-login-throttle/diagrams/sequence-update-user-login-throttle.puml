' @autogenerated
@startuml
title Modificación de user login throttle
autonumber
actor "Cliente" as A
participant "UserLoginThrottleUpdateController" as C
participant "UserLoginThrottleUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserLoginThrottlesVisibility" as V
participant "UserLoginThrottle" as D
participant "UserLoginThrottleCommandRepositoryGateway" as G
participant "UserLoginThrottleEventDispatcher" as E
participant "UserLoginThrottleCacheGateway" as K
participant "UserLoginThrottleAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserLoginThrottleUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserLoginThrottleUpdateCheck
U -> P : UserLoginThrottleUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserLoginThrottleUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserLoginThrottleUpdateProjection
C --> A : respuesta
@enduml
