' @autogenerated
@startuml
title Modificación de user scope consent
autonumber
actor "Cliente" as A
participant "UserScopeConsentUpdateController" as C
participant "UserScopeConsentUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserScopeConsentsVisibility" as V
participant "UserScopeConsent" as D
participant "UserScopeConsentCommandRepositoryGateway" as G
participant "UserScopeConsentEventDispatcher" as E
participant "UserScopeConsentCacheGateway" as K
participant "UserScopeConsentAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserScopeConsentUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserScopeConsentUpdateCheck
U -> P : UserScopeConsentUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserScopeConsentUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserScopeConsentUpdateProjection
C --> A : respuesta
@enduml
