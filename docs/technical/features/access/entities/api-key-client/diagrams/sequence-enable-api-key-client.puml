' @autogenerated
@startuml
title Enable de api key client
autonumber
actor "Cliente" as A
participant "ApiKeyClientEnableController" as C
participant "ApiKeyClientEnableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ApiKeyClientsVisibility" as V
participant "ApiKeyClient" as D
participant "ApiKeyClientCommandRepositoryGateway" as G
participant "ApiKeyClientEventDispatcher" as E
participant "ApiKeyClientCacheGateway" as K
participant "ApiKeyClientAuditGateway" as R

A -> C : petición HTTP
C -> U : enable(context, ...)
U -> P : ApiKeyClientEnableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ApiKeyClientEnableCheck
U -> D : original.enable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ApiKeyClientEnableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("enable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ApiKeyClientEnableProjection
C --> A : respuesta
@enduml
