' @autogenerated
@startuml
title Listado de api key client
autonumber
actor "Cliente" as A
participant "ApiKeyClientListController" as C
participant "ApiKeyClientListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ApiKeyClientsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ApiKeyClientListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ApiKeyClientListProjection>
C --> A : respuesta
@enduml
