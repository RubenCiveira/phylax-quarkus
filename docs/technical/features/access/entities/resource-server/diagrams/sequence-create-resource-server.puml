' @autogenerated
@startuml
title Creación de resource server
autonumber
actor "Cliente" as A
participant "ResourceServerCreateController" as C
participant "ResourceServerCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ResourceServersVisibility" as V
participant "ResourceServer" as D
participant "ResourceServerCommandRepositoryGateway" as G
participant "ResourceServerEventDispatcher" as E
participant "ResourceServerCacheGateway" as K
participant "ResourceServerAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ResourceServerCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ResourceServerCreateCheck
U -> P : ResourceServerCreateEnrich
U -> D : ResourceServer.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ResourceServerCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ResourceServerCreateProjection
C --> A : respuesta
@enduml
