' @autogenerated
@startuml
title Borrado de resource server
autonumber
actor "Cliente" as A
participant "ResourceServerDeleteController" as C
participant "ResourceServerDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ResourceServersVisibility" as V
participant "ResourceServer" as D
participant "ResourceServerCommandRepositoryGateway" as G
participant "ResourceServerEventDispatcher" as E
participant "ResourceServerCacheGateway" as K
participant "ResourceServerAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ResourceServerDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ResourceServerDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ResourceServerDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
