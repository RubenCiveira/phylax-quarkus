' @autogenerated
@startuml
title Disable de resource server
autonumber
actor "Cliente" as A
participant "ResourceServerDisableController" as C
participant "ResourceServerDisableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ResourceServersVisibility" as V
participant "ResourceServer" as D
participant "ResourceServerCommandRepositoryGateway" as G
participant "ResourceServerEventDispatcher" as E
participant "ResourceServerCacheGateway" as K
participant "ResourceServerAuditGateway" as R

A -> C : petición HTTP
C -> U : disable(context, ...)
U -> P : ResourceServerDisableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ResourceServerDisableCheck
U -> D : original.disable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ResourceServerDisableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("disable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ResourceServerDisableProjection
C --> A : respuesta
@enduml
