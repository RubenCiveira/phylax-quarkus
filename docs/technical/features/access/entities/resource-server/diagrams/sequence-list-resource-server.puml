' @autogenerated
@startuml
title Listado de resource server
autonumber
actor "Cliente" as A
participant "ResourceServerListController" as C
participant "ResourceServerListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ResourceServersVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ResourceServerListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ResourceServerListProjection>
C --> A : respuesta
@enduml
