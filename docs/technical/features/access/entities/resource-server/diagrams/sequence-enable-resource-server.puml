' @autogenerated
@startuml
title Enable de resource server
autonumber
actor "Cliente" as A
participant "ResourceServerEnableController" as C
participant "ResourceServerEnableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ResourceServersVisibility" as V
participant "ResourceServer" as D
participant "ResourceServerCommandRepositoryGateway" as G
participant "ResourceServerEventDispatcher" as E
participant "ResourceServerCacheGateway" as K
participant "ResourceServerAuditGateway" as R

A -> C : petición HTTP
C -> U : enable(context, ...)
U -> P : ResourceServerEnableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ResourceServerEnableCheck
U -> D : original.enable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ResourceServerEnableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("enable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ResourceServerEnableProjection
C --> A : respuesta
@enduml
