' @autogenerated
@startuml
title Borrado de dcr initial access token
autonumber
actor "Cliente" as A
participant "DcrInitialAccessTokenDeleteController" as C
participant "DcrInitialAccessTokenDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "DcrInitialAccessTokensVisibility" as V
participant "DcrInitialAccessToken" as D
participant "DcrInitialAccessTokenCommandRepositoryGateway" as G
participant "DcrInitialAccessTokenEventDispatcher" as E
participant "DcrInitialAccessTokenCacheGateway" as K
participant "DcrInitialAccessTokenAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : DcrInitialAccessTokenDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : DcrInitialAccessTokenDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : DcrInitialAccessTokenDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
