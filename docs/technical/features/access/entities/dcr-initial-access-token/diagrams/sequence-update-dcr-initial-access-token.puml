' @autogenerated
@startuml
title Modificación de dcr initial access token
autonumber
actor "Cliente" as A
participant "DcrInitialAccessTokenUpdateController" as C
participant "DcrInitialAccessTokenUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "DcrInitialAccessTokensVisibility" as V
participant "DcrInitialAccessToken" as D
participant "DcrInitialAccessTokenCommandRepositoryGateway" as G
participant "DcrInitialAccessTokenEventDispatcher" as E
participant "DcrInitialAccessTokenCacheGateway" as K
participant "DcrInitialAccessTokenAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : DcrInitialAccessTokenUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : DcrInitialAccessTokenUpdateCheck
U -> P : DcrInitialAccessTokenUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : DcrInitialAccessTokenUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : DcrInitialAccessTokenUpdateProjection
C --> A : respuesta
@enduml
