' @autogenerated
@startuml
title Listado de dcr initial access token
autonumber
actor "Cliente" as A
participant "DcrInitialAccessTokenListController" as C
participant "DcrInitialAccessTokenListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "DcrInitialAccessTokensVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : DcrInitialAccessTokenListAuthorizationDecision(context)
P --> U : permiso
