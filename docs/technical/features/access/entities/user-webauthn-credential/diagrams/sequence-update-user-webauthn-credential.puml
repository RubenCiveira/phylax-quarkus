' @autogenerated
@startuml
title Modificación de user webauthn credential
autonumber
actor "Cliente" as A
participant "UserWebauthnCredentialUpdateController" as C
participant "UserWebauthnCredentialUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserWebauthnCredentialsVisibility" as V
participant "UserWebauthnCredential" as D
participant "UserWebauthnCredentialCommandRepositoryGateway" as G
participant "UserWebauthnCredentialEventDispatcher" as E
participant "UserWebauthnCredentialCacheGateway" as K
participant "UserWebauthnCredentialAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserWebauthnCredentialUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserWebauthnCredentialUpdateCheck
U -> P : UserWebauthnCredentialUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserWebauthnCredentialUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserWebauthnCredentialUpdateProjection
C --> A : respuesta
@enduml
