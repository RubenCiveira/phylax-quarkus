' @autogenerated
@startuml
title Modificación de user personal api key
autonumber
actor "Cliente" as A
participant "UserPersonalApiKeyUpdateController" as C
participant "UserPersonalApiKeyUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserPersonalApiKeiesVisibility" as V
participant "UserPersonalApiKey" as D
participant "UserPersonalApiKeyCommandRepositoryGateway" as G
participant "UserPersonalApiKeyEventDispatcher" as E
participant "UserPersonalApiKeyCacheGateway" as K
