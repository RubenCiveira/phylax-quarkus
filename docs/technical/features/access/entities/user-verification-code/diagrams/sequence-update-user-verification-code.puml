' @autogenerated
@startuml
title Modificación de user verification code
autonumber
actor "Cliente" as A
participant "UserVerificationCodeUpdateController" as C
participant "UserVerificationCodeUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "UserVerificationCodesVisibility" as V
participant "UserVerificationCode" as D
participant "UserVerificationCodeCommandRepositoryGateway" as G
participant "UserVerificationCodeEventDispatcher" as E
participant "UserVerificationCodeCacheGateway" as K
participant "UserVerificationCodeAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : UserVerificationCodeUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : UserVerificationCodeUpdateCheck
U -> P : UserVerificationCodeUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : UserVerificationCodeUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : UserVerificationCodeUpdateProjection
C --> A : respuesta
@enduml
