' @autogenerated
@startuml
title Creación de role
autonumber
actor "Cliente" as A
participant "RoleCreateController" as C
participant "RoleCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "RolesVisibility" as V
participant "Role" as D
participant "RoleCommandRepositoryGateway" as G
participant "RoleEventDispatcher" as E
participant "RoleCacheGateway" as K
participant "RoleAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : RoleCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : RoleCreateCheck
U -> P : RoleCreateEnrich
U -> D : Role.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : RoleCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : RoleCreateProjection
C --> A : respuesta
@enduml
