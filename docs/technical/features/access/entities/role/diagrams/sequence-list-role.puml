' @autogenerated
@startuml
title Listado de role
autonumber
actor "Cliente" as A
participant "RoleListController" as C
participant "RoleListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "RolesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : RoleListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<RoleListProjection>
C --> A : respuesta
@enduml
