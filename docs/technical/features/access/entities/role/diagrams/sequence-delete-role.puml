' @autogenerated
@startuml
title Borrado de role
autonumber
actor "Cliente" as A
participant "RoleDeleteController" as C
participant "RoleDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "RolesVisibility" as V
participant "Role" as D
participant "RoleCommandRepositoryGateway" as G
participant "RoleEventDispatcher" as E
participant "RoleCacheGateway" as K
participant "RoleAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : RoleDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : RoleDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : RoleDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
