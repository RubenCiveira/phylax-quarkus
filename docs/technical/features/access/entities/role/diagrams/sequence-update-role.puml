' @autogenerated
@startuml
title Modificación de role
autonumber
actor "Cliente" as A
participant "RoleUpdateController" as C
participant "RoleUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "RolesVisibility" as V
participant "Role" as D
participant "RoleCommandRepositoryGateway" as G
participant "RoleEventDispatcher" as E
participant "RoleCacheGateway" as K
participant "RoleAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : RoleUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : RoleUpdateCheck
U -> P : RoleUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : RoleUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : RoleUpdateProjection
C --> A : respuesta
@enduml
