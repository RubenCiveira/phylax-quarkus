' @autogenerated
@startuml
title Listado de oauth client
autonumber
actor "Cliente" as A
participant "OauthClientListController" as C
participant "OauthClientListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "OauthClientsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : OauthClientListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<OauthClientListProjection>
C --> A : respuesta
@enduml
