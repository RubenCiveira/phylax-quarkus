' @autogenerated
@startuml
title Creación de oauth client
autonumber
actor "Cliente" as A
participant "OauthClientCreateController" as C
participant "OauthClientCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "OauthClientsVisibility" as V
participant "OauthClient" as D
participant "OauthClientCommandRepositoryGateway" as G
participant "OauthClientEventDispatcher" as E
participant "OauthClientCacheGateway" as K
participant "OauthClientAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : OauthClientCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : OauthClientCreateCheck
U -> P : OauthClientCreateEnrich
U -> D : OauthClient.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : OauthClientCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : OauthClientCreateProjection
C --> A : respuesta
@enduml
