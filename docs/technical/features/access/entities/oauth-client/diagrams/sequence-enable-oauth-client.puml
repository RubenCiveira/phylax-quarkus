' @autogenerated
@startuml
title Enable de oauth client
autonumber
actor "Cliente" as A
participant "OauthClientEnableController" as C
participant "OauthClientEnableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "OauthClientsVisibility" as V
participant "OauthClient" as D
participant "OauthClientCommandRepositoryGateway" as G
participant "OauthClientEventDispatcher" as E
participant "OauthClientCacheGateway" as K
participant "OauthClientAuditGateway" as R

A -> C : petición HTTP
C -> U : enable(context, ...)
U -> P : OauthClientEnableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : OauthClientEnableCheck
U -> D : original.enable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : OauthClientEnableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("enable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : OauthClientEnableProjection
C --> A : respuesta
@enduml
