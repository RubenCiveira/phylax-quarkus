' @autogenerated
@startuml
title Creación de snippet
autonumber
actor "Cliente" as A
participant "SnippetCreateController" as C
participant "SnippetCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetsVisibility" as V
participant "Snippet" as D
participant "SnippetCommandRepositoryGateway" as G
participant "SnippetEventDispatcher" as E
participant "SnippetCacheGateway" as K
participant "SnippetAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : SnippetCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : SnippetCreateCheck
U -> P : SnippetCreateEnrich
U -> D : Snippet.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : SnippetCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : SnippetCreateProjection
C --> A : respuesta
@enduml
