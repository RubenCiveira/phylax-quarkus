' @autogenerated
@startuml
title Modificación de snippet
autonumber
actor "Cliente" as A
participant "SnippetUpdateController" as C
participant "SnippetUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetsVisibility" as V
participant "Snippet" as D
participant "SnippetCommandRepositoryGateway" as G
participant "SnippetEventDispatcher" as E
participant "SnippetCacheGateway" as K
participant "SnippetAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : SnippetUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : SnippetUpdateCheck
U -> P : SnippetUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : SnippetUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : SnippetUpdateProjection
C --> A : respuesta
@enduml
