' @autogenerated
@startuml
title Borrado de snippet
autonumber
actor "Cliente" as A
participant "SnippetDeleteController" as C
participant "SnippetDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetsVisibility" as V
participant "Snippet" as D
participant "SnippetCommandRepositoryGateway" as G
participant "SnippetEventDispatcher" as E
participant "SnippetCacheGateway" as K
participant "SnippetAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : SnippetDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : SnippetDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : SnippetDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
