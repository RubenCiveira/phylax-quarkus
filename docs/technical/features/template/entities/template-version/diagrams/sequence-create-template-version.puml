end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TemplateVersionCreateCheck
U -> P : TemplateVersionCreateEnrich
U -> D : TemplateVersion.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : TemplateVersionCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : TemplateVersionCreateProjection
C --> A : respuesta
