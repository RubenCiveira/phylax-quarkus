@startuml
title Creación de template version
autonumber
actor "Cliente" as A
participant "TemplateVersionCreateController" as C
participant "TemplateVersionCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateVersionsVisibility" as V
