' @autogenerated
@startuml
title Modificación de snippet version
autonumber
actor "Cliente" as A
participant "SnippetVersionUpdateController" as C
participant "SnippetVersionUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetVersionsVisibility" as V
participant "SnippetVersion" as D
participant "SnippetVersionCommandRepositoryGateway" as G
participant "SnippetVersionEventDispatcher" as E
participant "SnippetVersionCacheGateway" as K
participant "SnippetVersionAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : SnippetVersionUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : SnippetVersionUpdateCheck
U -> P : SnippetVersionUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : SnippetVersionUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : SnippetVersionUpdateProjection
C --> A : respuesta
@enduml
