' @autogenerated
@startuml
title Listado de snippet version
autonumber
actor "Cliente" as A
participant "SnippetVersionListController" as C
participant "SnippetVersionListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetVersionsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : SnippetVersionListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<SnippetVersionListProjection>
C --> A : respuesta
@enduml
