' @autogenerated
@startuml
title Enable de theme asset
autonumber
actor "Cliente" as A
participant "ThemeAssetEnableController" as C
participant "ThemeAssetEnableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemeAssetsVisibility" as V
participant "ThemeAsset" as D
participant "ThemeAssetCommandRepositoryGateway" as G
participant "ThemeAssetEventDispatcher" as E
participant "ThemeAssetCacheGateway" as K
participant "ThemeAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : enable(context, ...)
U -> P : ThemeAssetEnableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ThemeAssetEnableCheck
U -> D : original.enable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ThemeAssetEnableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("enable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ThemeAssetEnableProjection
C --> A : respuesta
@enduml
