' @autogenerated
@startuml
title Listado de theme asset
autonumber
actor "Cliente" as A
participant "ThemeAssetListController" as C
participant "ThemeAssetListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemeAssetsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ThemeAssetListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ThemeAssetListProjection>
C --> A : respuesta
@enduml
