' @autogenerated
@startuml
title Borrado de theme asset
autonumber
actor "Cliente" as A
participant "ThemeAssetDeleteController" as C
participant "ThemeAssetDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemeAssetsVisibility" as V
participant "ThemeAsset" as D
participant "ThemeAssetCommandRepositoryGateway" as G
participant "ThemeAssetEventDispatcher" as E
participant "ThemeAssetCacheGateway" as K
participant "ThemeAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ThemeAssetDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ThemeAssetDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ThemeAssetDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
