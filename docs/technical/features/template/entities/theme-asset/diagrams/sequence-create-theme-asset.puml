' @autogenerated
@startuml
title Creación de theme asset
autonumber
actor "Cliente" as A
participant "ThemeAssetCreateController" as C
participant "ThemeAssetCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemeAssetsVisibility" as V
participant "ThemeAsset" as D
participant "ThemeAssetCommandRepositoryGateway" as G
participant "ThemeAssetEventDispatcher" as E
participant "ThemeAssetCacheGateway" as K
participant "ThemeAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ThemeAssetCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ThemeAssetCreateCheck
U -> P : ThemeAssetCreateEnrich
U -> D : ThemeAsset.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ThemeAssetCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ThemeAssetCreateProjection
C --> A : respuesta
@enduml
