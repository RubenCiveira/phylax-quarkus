' @autogenerated
@startuml
title Modificación de theme version
autonumber
actor "Cliente" as A
participant "ThemeVersionUpdateController" as C
participant "ThemeVersionUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemeVersionsVisibility" as V
participant "ThemeVersion" as D
participant "ThemeVersionCommandRepositoryGateway" as G
participant "ThemeVersionEventDispatcher" as E
participant "ThemeVersionCacheGateway" as K
participant "ThemeVersionAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : ThemeVersionUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ThemeVersionUpdateCheck
U -> P : ThemeVersionUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ThemeVersionUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ThemeVersionUpdateProjection
C --> A : respuesta
@enduml
