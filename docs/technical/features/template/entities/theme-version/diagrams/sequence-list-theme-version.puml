' @autogenerated
@startuml
title Listado de theme version
autonumber
actor "Cliente" as A
participant "ThemeVersionListController" as C
participant "ThemeVersionListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemeVersionsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ThemeVersionListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ThemeVersionListProjection>
C --> A : respuesta
@enduml
