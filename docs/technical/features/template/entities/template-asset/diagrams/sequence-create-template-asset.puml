' @autogenerated
@startuml
title Creación de template asset
autonumber
actor "Cliente" as A
participant "TemplateAssetCreateController" as C
participant "TemplateAssetCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateAssetsVisibility" as V
participant "TemplateAsset" as D
participant "TemplateAssetCommandRepositoryGateway" as G
participant "TemplateAssetEventDispatcher" as E
participant "TemplateAssetCacheGateway" as K
participant "TemplateAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : TemplateAssetCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TemplateAssetCreateCheck
U -> P : TemplateAssetCreateEnrich
U -> D : TemplateAsset.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : TemplateAssetCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : TemplateAssetCreateProjection
C --> A : respuesta
@enduml
