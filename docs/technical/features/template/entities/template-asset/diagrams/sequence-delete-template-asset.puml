' @autogenerated
@startuml
title Borrado de template asset
autonumber
actor "Cliente" as A
participant "TemplateAssetDeleteController" as C
participant "TemplateAssetDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateAssetsVisibility" as V
participant "TemplateAsset" as D
participant "TemplateAssetCommandRepositoryGateway" as G
participant "TemplateAssetEventDispatcher" as E
participant "TemplateAssetCacheGateway" as K
participant "TemplateAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : TemplateAssetDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : TemplateAssetDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : TemplateAssetDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
