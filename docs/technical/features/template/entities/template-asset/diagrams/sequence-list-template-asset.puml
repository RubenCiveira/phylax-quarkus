' @autogenerated
@startuml
title Listado de template asset
autonumber
actor "Cliente" as A
participant "TemplateAssetListController" as C
participant "TemplateAssetListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateAssetsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : TemplateAssetListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<TemplateAssetListProjection>
C --> A : respuesta
@enduml
