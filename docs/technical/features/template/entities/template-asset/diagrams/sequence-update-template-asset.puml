' @autogenerated
@startuml
title Modificación de template asset
autonumber
actor "Cliente" as A
participant "TemplateAssetUpdateController" as C
participant "TemplateAssetUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateAssetsVisibility" as V
participant "TemplateAsset" as D
participant "TemplateAssetCommandRepositoryGateway" as G
participant "TemplateAssetEventDispatcher" as E
participant "TemplateAssetCacheGateway" as K
participant "TemplateAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : TemplateAssetUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TemplateAssetUpdateCheck
U -> P : TemplateAssetUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : TemplateAssetUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : TemplateAssetUpdateProjection
C --> A : respuesta
@enduml
