' @autogenerated
@startuml
title Listado de template variable
autonumber
actor "Cliente" as A
participant "TemplateVariableListController" as C
participant "TemplateVariableListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateVariablesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : TemplateVariableListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<TemplateVariableListProjection>
C --> A : respuesta
@enduml
