' @autogenerated
@startuml
title Borrado de template variable
autonumber
actor "Cliente" as A
participant "TemplateVariableDeleteController" as C
participant "TemplateVariableDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateVariablesVisibility" as V
participant "TemplateVariable" as D
participant "TemplateVariableCommandRepositoryGateway" as G
participant "TemplateVariableEventDispatcher" as E
participant "TemplateVariableCacheGateway" as K
participant "TemplateVariableAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : TemplateVariableDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : TemplateVariableDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : TemplateVariableDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
