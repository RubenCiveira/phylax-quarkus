' @autogenerated
@startuml
title Enable de template variable
autonumber
actor "Cliente" as A
participant "TemplateVariableEnableController" as C
participant "TemplateVariableEnableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateVariablesVisibility" as V
participant "TemplateVariable" as D
participant "TemplateVariableCommandRepositoryGateway" as G
participant "TemplateVariableEventDispatcher" as E
participant "TemplateVariableCacheGateway" as K
participant "TemplateVariableAuditGateway" as R

A -> C : petición HTTP
C -> U : enable(context, ...)
U -> P : TemplateVariableEnableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : TemplateVariableEnableCheck
U -> D : original.enable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : TemplateVariableEnableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("enable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : TemplateVariableEnableProjection
C --> A : respuesta
@enduml
