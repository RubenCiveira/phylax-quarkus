' @autogenerated
@startuml
title Creación de template variable
autonumber
actor "Cliente" as A
participant "TemplateVariableCreateController" as C
participant "TemplateVariableCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplateVariablesVisibility" as V
participant "TemplateVariable" as D
participant "TemplateVariableCommandRepositoryGateway" as G
participant "TemplateVariableEventDispatcher" as E
participant "TemplateVariableCacheGateway" as K
participant "TemplateVariableAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : TemplateVariableCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TemplateVariableCreateCheck
U -> P : TemplateVariableCreateEnrich
U -> D : TemplateVariable.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : TemplateVariableCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : TemplateVariableCreateProjection
C --> A : respuesta
@enduml
