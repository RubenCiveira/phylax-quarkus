' @autogenerated
@startuml
title Descarga de content de snippet asset
autonumber
actor "Cliente" as A
participant "SnippetAssetContentUploadController" as C
participant "SnippetAssetContentRetrieveUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetAssetsVisibility" as V
participant "SnippetAssetContentUploadGateway" as S

A -> C : petición HTTP
C -> U : read(context, ...)
U -> P : SnippetAssetContentRetrieveAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisible(context, uid)
V --> U : registro, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> S : readContent(entity)
S --> U : BinaryContent
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U --> C : BinaryContent
C --> A : respuesta
@enduml
