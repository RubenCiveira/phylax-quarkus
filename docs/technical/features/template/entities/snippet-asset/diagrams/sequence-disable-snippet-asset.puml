@startuml
title Disable de snippet asset
autonumber
actor "Cliente" as A
participant "SnippetAssetDisableController" as C
participant "SnippetAssetDisableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetAssetsVisibility" as V
participant "SnippetAsset" as D
participant "SnippetAssetCommandRepositoryGateway" as G
participant "SnippetAssetEventDispatcher" as E
participant "SnippetAssetCacheGateway" as K
