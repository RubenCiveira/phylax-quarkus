A -> C : petición HTTP
C -> U : disable(context, ...)
U -> P : SnippetAssetDisableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : SnippetAssetDisableCheck
U -> D : original.disable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : SnippetAssetDisableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("disable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : SnippetAssetDisableProjection
C --> A : respuesta
