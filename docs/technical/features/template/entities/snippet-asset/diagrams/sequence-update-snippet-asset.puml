' @autogenerated
@startuml
title Modificación de snippet asset
autonumber
actor "Cliente" as A
participant "SnippetAssetUpdateController" as C
participant "SnippetAssetUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetAssetsVisibility" as V
participant "SnippetAsset" as D
participant "SnippetAssetCommandRepositoryGateway" as G
participant "SnippetAssetEventDispatcher" as E
participant "SnippetAssetCacheGateway" as K
participant "SnippetAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : SnippetAssetUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : SnippetAssetUpdateCheck
U -> P : SnippetAssetUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : SnippetAssetUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : SnippetAssetUpdateProjection
C --> A : respuesta
@enduml
