' @autogenerated
@startuml
title Creación de snippet asset
autonumber
actor "Cliente" as A
participant "SnippetAssetCreateController" as C
participant "SnippetAssetCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetAssetsVisibility" as V
participant "SnippetAsset" as D
participant "SnippetAssetCommandRepositoryGateway" as G
participant "SnippetAssetEventDispatcher" as E
participant "SnippetAssetCacheGateway" as K
participant "SnippetAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : SnippetAssetCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : SnippetAssetCreateCheck
U -> P : SnippetAssetCreateEnrich
U -> D : SnippetAsset.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : SnippetAssetCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : SnippetAssetCreateProjection
C --> A : respuesta
@enduml
