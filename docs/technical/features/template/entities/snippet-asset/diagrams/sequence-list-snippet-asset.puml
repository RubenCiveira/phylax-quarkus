' @autogenerated
@startuml
title Listado de snippet asset
autonumber
actor "Cliente" as A
participant "SnippetAssetListController" as C
participant "SnippetAssetListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetAssetsVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : SnippetAssetListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<SnippetAssetListProjection>
C --> A : respuesta
@enduml
