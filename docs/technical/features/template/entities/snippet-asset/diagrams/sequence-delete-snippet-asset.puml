' @autogenerated
@startuml
title Borrado de snippet asset
autonumber
actor "Cliente" as A
participant "SnippetAssetDeleteController" as C
participant "SnippetAssetDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SnippetAssetsVisibility" as V
participant "SnippetAsset" as D
participant "SnippetAssetCommandRepositoryGateway" as G
participant "SnippetAssetEventDispatcher" as E
participant "SnippetAssetCacheGateway" as K
participant "SnippetAssetAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : SnippetAssetDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : SnippetAssetDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : SnippetAssetDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
