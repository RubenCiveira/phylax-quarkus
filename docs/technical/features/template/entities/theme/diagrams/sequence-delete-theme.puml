' @autogenerated
@startuml
title Borrado de theme
autonumber
actor "Cliente" as A
participant "ThemeDeleteController" as C
participant "ThemeDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemesVisibility" as V
participant "Theme" as D
participant "ThemeCommandRepositoryGateway" as G
participant "ThemeEventDispatcher" as E
participant "ThemeCacheGateway" as K
participant "ThemeAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : ThemeDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ThemeDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : ThemeDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
