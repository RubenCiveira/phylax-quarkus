' @autogenerated
@startuml
title Enable de theme
autonumber
actor "Cliente" as A
participant "ThemeEnableController" as C
participant "ThemeEnableUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemesVisibility" as V
participant "Theme" as D
participant "ThemeCommandRepositoryGateway" as G
participant "ThemeEventDispatcher" as E
participant "ThemeCacheGateway" as K
participant "ThemeAuditGateway" as R

A -> C : petición HTTP
C -> U : enable(context, ...)
U -> P : ThemeEnableAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : ThemeEnableCheck
U -> D : original.enable()
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : ThemeEnableEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("enable", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : ThemeEnableProjection
C --> A : respuesta
@enduml
