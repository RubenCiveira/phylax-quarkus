' @autogenerated
@startuml
title Listado de theme
autonumber
actor "Cliente" as A
participant "ThemeListController" as C
participant "ThemeListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : ThemeListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<ThemeListProjection>
C --> A : respuesta
@enduml
