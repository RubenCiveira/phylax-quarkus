' @autogenerated
@startuml
title Creación de theme
autonumber
actor "Cliente" as A
participant "ThemeCreateController" as C
participant "ThemeCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "ThemesVisibility" as V
participant "Theme" as D
participant "ThemeCommandRepositoryGateway" as G
participant "ThemeEventDispatcher" as E
participant "ThemeCacheGateway" as K
participant "ThemeAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : ThemeCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : ThemeCreateCheck
U -> P : ThemeCreateEnrich
U -> D : Theme.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : ThemeCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : ThemeCreateProjection
C --> A : respuesta
@enduml
