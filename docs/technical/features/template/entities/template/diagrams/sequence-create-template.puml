' @autogenerated
@startuml
title Creación de template
autonumber
actor "Cliente" as A
participant "TemplateCreateController" as C
participant "TemplateCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplatesVisibility" as V
participant "Template" as D
participant "TemplateCommandRepositoryGateway" as G
participant "TemplateEventDispatcher" as E
participant "TemplateCacheGateway" as K
participant "TemplateAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : TemplateCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TemplateCreateCheck
U -> P : TemplateCreateEnrich
U -> D : Template.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : TemplateCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : TemplateCreateProjection
C --> A : respuesta
@enduml
