' @autogenerated
@startuml
title Borrado de template
autonumber
actor "Cliente" as A
participant "TemplateDeleteController" as C
participant "TemplateDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplatesVisibility" as V
participant "Template" as D
participant "TemplateCommandRepositoryGateway" as G
participant "TemplateEventDispatcher" as E
participant "TemplateCacheGateway" as K
participant "TemplateAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : TemplateDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : TemplateDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : TemplateDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
