' @autogenerated
@startuml
title Modificación de template
autonumber
actor "Cliente" as A
participant "TemplateUpdateController" as C
participant "TemplateUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "TemplatesVisibility" as V
participant "Template" as D
participant "TemplateCommandRepositoryGateway" as G
participant "TemplateEventDispatcher" as E
participant "TemplateCacheGateway" as K
participant "TemplateAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : TemplateUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : TemplateUpdateCheck
U -> P : TemplateUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : TemplateUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : TemplateUpdateProjection
C --> A : respuesta
@enduml
