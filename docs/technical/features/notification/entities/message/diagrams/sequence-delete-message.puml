' @autogenerated
@startuml
title Borrado de message
autonumber
actor "Cliente" as A
participant "MessageDeleteController" as C
participant "MessageDeleteUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "MessagesVisibility" as V
participant "Message" as D
participant "MessageCommandRepositoryGateway" as G
participant "MessageEventDispatcher" as E
participant "MessageCacheGateway" as K
participant "MessageAuditGateway" as R

A -> C : petición HTTP
C -> U : delete(context, ...)
U -> P : MessageDeleteAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> P : MessageDeleteCheck
U -> D : original.delete()
D --> U : agregado con los eventos registrados
U -> G : delete(entity)
G -> G : persistir
G ->> E : MessageDeleteEvent
G --> U : guardado
U -> K : evict
U -> R : deleted("delete", original, context)
U --> C : void
C --> A : respuesta
@enduml
