' @autogenerated
@startuml
title Listado de message
autonumber
actor "Cliente" as A
participant "MessageListController" as C
participant "MessageListUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "MessagesVisibility" as V

A -> C : petición HTTP
C -> U : list(context, ...)
U -> P : MessageListAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : listCachedVisibles(context, filter, cursor)
V --> U : registros visibles de la página
U -> V : copyWithHidden(context, value)
V --> U : sin las propiedades ocultas
U --> C : List<MessageListProjection>
C --> A : respuesta
@enduml
