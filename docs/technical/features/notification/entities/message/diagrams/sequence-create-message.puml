' @autogenerated
@startuml
title Creación de message
autonumber
actor "Cliente" as A
participant "MessageCreateController" as C
participant "MessageCreateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "MessagesVisibility" as V
participant "Message" as D
participant "MessageCommandRepositoryGateway" as G
participant "MessageEventDispatcher" as E
participant "MessageCacheGateway" as K
participant "MessageAuditGateway" as R

A -> C : petición HTTP
C -> U : create(context, ...)
U -> P : MessageCreateAuthorizationDecision(context)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : MessageCreateCheck
U -> P : MessageCreateEnrich
U -> D : Message.create(changeSet)
D --> U : agregado con los eventos registrados
U -> G : create(entity)
G -> G : persistir
G ->> E : MessageCreateEvent
G --> U : guardado
U -> K : update(created)
U -> R : created("create", created, context)
U -> V : copyWithHidden(context, created)
V --> U : sin las propiedades ocultas
U --> C : MessageCreateProjection
C --> A : respuesta
@enduml
