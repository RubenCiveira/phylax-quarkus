' @autogenerated
@startuml
title Modificación de smtp outbound config
autonumber
actor "Cliente" as A
participant "SmtpOutboundConfigUpdateController" as C
participant "SmtpOutboundConfigUpdateUsecase" as U
participant "Políticas\n(observadores CDI)" as P
participant "SmtpOutboundConfigsVisibility" as V
participant "SmtpOutboundConfig" as D
participant "SmtpOutboundConfigCommandRepositoryGateway" as G
participant "SmtpOutboundConfigEventDispatcher" as E
participant "SmtpOutboundConfigCacheGateway" as K
participant "SmtpOutboundConfigAuditGateway" as R

A -> C : petición HTTP
C -> U : update(context, ...)
U -> P : SmtpOutboundConfigUpdateAuthorizationDecision(context, reference)
P --> U : permiso
alt no permitido
  U --> C : NotAllowedException
  C --> A : 401 / 403
end
U -> V : retrieveVisibleForUpdate(context, uid)
V --> U : original, si es visible
alt no existe o no es visible
  U --> C : NotFoundException
  C --> A : 404
end
U -> V : copyWithFixed(context, input)
V --> U : entrada con las propiedades fijadas
U -> P : SmtpOutboundConfigUpdateCheck
U -> P : SmtpOutboundConfigUpdateEnrich
U -> D : original.update(changeSet)
D --> U : agregado con los eventos registrados
U -> G : update(original, changed)
G -> G : persistir
G ->> E : SmtpOutboundConfigUpdateEvent
G --> U : guardado
U -> K : update(saved)
U -> R : updated("update", saved, original, context)
U -> V : copyWithHidden(context, saved)
V --> U : sin las propiedades ocultas
U --> C : SmtpOutboundConfigUpdateProjection
C --> A : respuesta
@enduml
