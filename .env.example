# Variables para arrancar phylax-api en local. Quarkus lee .env al arrancar (mvn quarkus:dev, java -jar...).
# .env.example es la plantilla que se versiona; .env es la copia local, ignorada por git: ajústala a tu entorno.

# Aplicación: puerto HTTP y puerto de gestión (health y métricas)
APP_PORT=8090
MANAGEMENT_PORT=9000

# Base de datos (mariadb). Las migraciones crean las tablas al arrancar, pero la base y el usuario tienen que
# existir antes:
#   CREATE DATABASE phylax;
#   CREATE USER 'phylax'@'%' IDENTIFIED BY 'phylax';
#   GRANT ALL ON phylax.* TO 'phylax'@'%';
DATASOURCE_HOST=localhost
DATASOURCE_PORT=3306
DATASOURCE_PATH=phylax
DATASOURCE_USER=phylax
DATASOURCE_PASS=phylax

# Correo. En dev Quarkus simula los envíos (quarkus.mailer.mock), pero los valores tienen que existir; para verlos
# llegar, un servidor SMTP local como Mailpit (localhost:1025).
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_START_TLS=DISABLED
MAILER_FROM_EMAIL=no-reply@localhost
MAILER_USERNAME=phylax
MAILER_PASSWORD=phylax

# Anillos de claves de los secretos protegidos (formato "id:secreto,id2:secreto2"). En los perfiles dev y test
# tienen valores de desarrollo en config/security.yaml; fuera de ellos son obligatorios:
# SECURITY_DIGEST_PEPPERS=p1:<secreto largo y aleatorio>
# SECURITY_DIGEST_CURRENT=p1
# SECURITY_SECRETS_KEYS=k1:<secreto largo y aleatorio, del que se deriva la clave AES>
# SECURITY_SECRETS_CURRENT=k1
